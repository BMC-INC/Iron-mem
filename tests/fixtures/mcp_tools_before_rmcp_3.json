  {
    "name": "remember",
    "description": "Store an explicit, durable governed memory. Use scope='user' for facts/preferences that apply across projects inside the namespace; scope='project' (default) for this project only. PHI/PII requires consent_state='granted'.",
    "inputSchema": {
      "properties": {
        "classification": {
          "description": "public | internal | confidential | restricted | phi | pii",
          "type": "string"
        },
        "consent_state": {
          "description": "required | granted | denied | withdrawn; PHI/PII requires granted",
          "type": "string"
        },
        "event_at": {
          "description": "Optional ISO date YYYY-MM-DD (or range YYYY-MM-DD..YYYY-MM-DD) of when the described event actually occurred or will occur. This is the event/valid time, distinct from the storage time (created_at). Powers time-aware retrieval.",
          "type": "string"
        },
        "expires_at": {
          "description": "Optional Unix timestamp expiry",
          "type": "integer"
        },
        "kind": {
          "description": "session | error_solution | preference | architecture | learned_pattern | project_config | profile (default preference)",
          "type": "string"
        },
        "legal_hold": {
          "description": "If true, governed forget refuses deletion",
          "type": "boolean"
        },
        "namespace": {
          "description": "Governance namespace/realm boundary (default local)",
          "type": "string"
        },
        "project": {
          "description": "Project root path",
          "type": "string"
        },
        "residency": {
          "description": "Optional residency tag",
          "type": "string"
        },
        "retention_policy_id": {
          "description": "Optional retention policy id",
          "type": "string"
        },
        "scope": {
          "description": "'project' (default) or 'user' (cross-project)",
          "type": "string"
        },
        "source_ref": {
          "description": "Optional source event, receipt, URL, or tool id",
          "type": "string"
        },
        "source_type": {
          "description": "user_input | tool_output | agent_generated | derived | external | sync_peer",
          "type": "string"
        },
        "tags": {
          "description": "Optional space-separated keywords",
          "type": "string"
        },
        "text": {
          "description": "The memory content to store verbatim",
          "type": "string"
        },
        "trust_tier": {
          "description": "high | medium | low | untrusted",
          "type": "string"
        },
        "writer_identity": {
          "description": "Writer identity for the tamper-evident ledger",
          "type": "string"
        }
      },
      "required": [
        "project",
        "text"
      ],
      "type": "object"
    }
  },
